  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I think it's very important\nto be extremely thoughtful"
    } ]
  }, {
    "tStartMs": 2490,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "about how does this new\ntechnology affect all humans."
    } ]
  }, {
    "tStartMs": 6390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Running a tech company\nat a very high pace,"
    } ]
  }, {
    "tStartMs": 8970,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "it's not for the faint of heart."
    } ]
  }, {
    "tStartMs": 11550,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Doing it right and making\nsure that even though it's."
    } ]
  }, {
    "tStartMs": 14910,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "everyone has to move really, really fast,"
    } ]
  }, {
    "tStartMs": 16650,
    "dDurationMs": 1856,
    "segs": [ {
      "utf8": "do so responsibly."
    } ]
  }, {
    "tStartMs": 18506,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(gentle music)"
    } ]
  }, {
    "tStartMs": 23310,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Lovable lets anyone take\nan idea for software"
    } ]
  }, {
    "tStartMs": 26400,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and build it themselves\nby having a conversation"
    } ]
  }, {
    "tStartMs": 28590,
    "dDurationMs": 963,
    "segs": [ {
      "utf8": "with our platform."
    } ]
  }, {
    "tStartMs": 30540,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "With the business of\nunlocking new economies,"
    } ]
  }, {
    "tStartMs": 34380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "empowering every human out there"
    } ]
  }, {
    "tStartMs": 36180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "who wants to create something."
    } ]
  }, {
    "tStartMs": 38430,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "- What is unlocked by Anthropic"
    } ]
  }, {
    "tStartMs": 39990,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "and Lovable working together?"
    } ]
  }, {
    "tStartMs": 41400,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Since everything's been exploding,"
    } ]
  }, {
    "tStartMs": 43950,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "there's been more support"
    } ]
  }, {
    "tStartMs": 45630,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and more interactions between our teams."
    } ]
  }, {
    "tStartMs": 47160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "We've gotten dedicated people\nfrom the Anthropic team"
    } ]
  }, {
    "tStartMs": 49620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "that works with us."
    } ]
  }, {
    "tStartMs": 50453,
    "dDurationMs": 2197,
    "segs": [ {
      "utf8": "It starts feeling more like\nwe're building something"
    } ]
  }, {
    "tStartMs": 52650,
    "dDurationMs": 3393,
    "segs": [ {
      "utf8": "together than just a\ncustomer vendor relationship."
    } ]
  }, {
    "tStartMs": 57030,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "We launched this product two months ago."
    } ]
  }, {
    "tStartMs": 60210,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "User growth has been really good."
    } ]
  }, {
    "tStartMs": 63150,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Needless to say, I think we\nare all standing in front"
    } ]
  }, {
    "tStartMs": 67050,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "of a generational shift."
    } ]
  }, {
    "tStartMs": 68370,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "My advice to founders working\nwith Anthropic would be"
    } ]
  }, {
    "tStartMs": 71460,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "to dig into a partnership and ask for help"
    } ]
  }, {
    "tStartMs": 75870,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and spend time with the team"
    } ]
  }, {
    "tStartMs": 77070,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "because these are humans\nthat actually really care."
    } ]
  }, {
    "tStartMs": 80760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "- So I've heard you say\nthe most underrated moat in"
    } ]
  }, {
    "tStartMs": 83490,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "AI is trust."
    } ]
  }, {
    "tStartMs": 84720,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "- Something that I\nthink is very rare in AI"
    } ]
  }, {
    "tStartMs": 87210,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "is a trusted brand that people\nlove and keep coming back to"
    } ]
  }, {
    "tStartMs": 90960,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and to have that trusted brand,"
    } ]
  }, {
    "tStartMs": 93295,
    "dDurationMs": 3695,
    "segs": [ {
      "utf8": "that's not something that\nyou magically achieve."
    } ]
  }, {
    "tStartMs": 96990,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's really warming my heart,"
    } ]
  }, {
    "tStartMs": 98670,
    "dDurationMs": 2638,
    "segs": [ {
      "utf8": "feeling the exciting things\neveryone is building."
    } ]
  }, {
    "tStartMs": 101308,
    "dDurationMs": 1232,
    "segs": [ {
      "utf8": "(audience applauds)"
    } ]
  }, {
    "tStartMs": 102540,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "One of the values we have at\nLovable is to care deeply,"
    } ]
  }, {
    "tStartMs": 107400,
    "dDurationMs": 2273,
    "segs": [ {
      "utf8": "constantly be obsessed and think about"
    } ]
  }, {
    "tStartMs": 109673,
    "dDurationMs": 3097,
    "segs": [ {
      "utf8": "what do our customers\nneed, what they want."
    } ]
  }, {
    "tStartMs": 112770,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "It's about the craft and every\ndetail of what you're doing"
    } ]
  }, {
    "tStartMs": 116730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "when you're improving\nyour product experience"
    } ]
  }, {
    "tStartMs": 118620,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "and making sure to make\nthis like super hard topic"
    } ]
  }, {
    "tStartMs": 121950,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "of software development simple."
    } ]
  }, {
    "tStartMs": 125250,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "(speaking foreign language)"
    } ]
  }, {
    "tStartMs": 127620,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "- I'm super excited about this world"
    } ]
  }, {
    "tStartMs": 129000,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "where more things are possible."
    } ]
  }, {
    "tStartMs": 130890,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "There is fundamentally more\nhuman agency that's unlocked"
    } ]
  }, {
    "tStartMs": 135840,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "when frictions for starting a company"
    } ]
  }, {
    "tStartMs": 139050,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "and building your product,\nthey start disappearing."
    } ]
  }, {
    "tStartMs": 142440,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "So I think we're entering an era"
    } ]
  }, {
    "tStartMs": 145650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "where there are more societal problems"
    } ]
  }, {
    "tStartMs": 147990,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "that are getting solved."
    } ]
  }, {
    "tStartMs": 149280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "We're seeing that live\nwith millions of people"
    } ]
  }, {
    "tStartMs": 152520,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "building on top of our platform."
    } ]
  }, {
    "tStartMs": 154873,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "(gentle music continues)"
    } ]
  } ]
}
