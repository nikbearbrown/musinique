{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 41,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "I want to learn how to do\npanorama Milky Way photos."
    } ]
  }, {
    "tStartMs": 2500,
    "dDurationMs": 3625,
    "segs": [ {
      "utf8": "So,using Claude to like, give me some\nbullet points on how to achieve that."
    } ]
  }, {
    "tStartMs": 6125,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "It's been super great."
    } ]
  }, {
    "tStartMs": 8708,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "I'm Shane Auckland."
    } ]
  }, {
    "tStartMs": 10000,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "My hobbies are usually\npretty intense."
    } ]
  }, {
    "tStartMs": 11666,
    "dDurationMs": 2625,
    "segs": [ {
      "utf8": "I like things that are hard\nthat I have to practice a lot."
    } ]
  }, {
    "tStartMs": 14583,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Astrophotography is going out\nliterally to the middle of nowhere"
    } ]
  }, {
    "tStartMs": 17583,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "and shooting the stars."
    } ]
  }, {
    "tStartMs": 18666,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "It's the role of the dice\nand you go with the wind."
    } ]
  }, {
    "tStartMs": 20708,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "Everything really has to align\nlike the stars have to align."
    } ]
  }, {
    "tStartMs": 24708,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Death Valley is a huge national park."
    } ]
  }, {
    "tStartMs": 26958,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "I mean you can get lost pretty easily\nif you're not smart about it."
    } ]
  }, {
    "tStartMs": 29500,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "The Milky Way would be\narching over here."
    } ]
  }, {
    "tStartMs": 31791,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "Usually when you're doing this,"
    } ]
  }, {
    "tStartMs": 32708,
    "dDurationMs": 2292,
    "segs": [ {
      "utf8": "you're in the middle of nowhere\nand it is super quiet."
    } ]
  }, {
    "tStartMs": 35458,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And that is like such an\nawesome feeling."
    } ]
  }, {
    "tStartMs": 38083,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "With the naked eye you actually \nreally can’t see the Milky Way,"
    } ]
  }, {
    "tStartMs": 40500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but with the lens\nyou can open that aperture"
    } ]
  }, {
    "tStartMs": 42500,
    "dDurationMs": 1916,
    "segs": [ {
      "utf8": "all the way open and\nallow all that light"
    } ]
  }, {
    "tStartMs": 44416,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "to come in, and all of a sudden\nyou're seeing outer space."
    } ]
  }, {
    "tStartMs": 50916,
    "dDurationMs": 2792,
    "segs": [ {
      "utf8": "I'm going to rotate about 30 degrees,\nI think should be enough"
    } ]
  }, {
    "tStartMs": 53708,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "to overlap the panorama photo,"
    } ]
  }, {
    "tStartMs": 55458,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "because the idea is to get\nthis whole mountain"
    } ]
  }, {
    "tStartMs": 57208,
    "dDurationMs": 1833,
    "segs": [ {
      "utf8": "like in the shot once \nthe Milky Way comes out."
    } ]
  }, {
    "tStartMs": 60208,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "25 second exposure."
    } ]
  }, {
    "tStartMs": 62000,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "We're definitely not there yet."
    } ]
  }, {
    "tStartMs": 63083,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "A little a little longer I think."
    } ]
  }, {
    "tStartMs": 64791,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "You're gonna fail, but\nyou got to keep going"
    } ]
  }, {
    "tStartMs": 66375,
    "dDurationMs": 2375,
    "segs": [ {
      "utf8": "and keep pushing forward\nand just keep thinking."
    } ]
  }, {
    "tStartMs": 68875,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "I mean I hope we can get it\ntonight that would be so sick."
    } ]
  }, {
    "tStartMs": 71000,
    "dDurationMs": 1541,
    "segs": [ {
      "utf8": "I'd be very excited."
    } ]
  } ]
}
