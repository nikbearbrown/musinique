  }, {
    "tStartMs": 665840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and this was like\ntwo big leaps."
    } ]
  }, {
    "tStartMs": 667360,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "If you take like, a step back,\nhow are you"
