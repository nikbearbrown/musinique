  }, {
    "tStartMs": 608560,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "that I've learned over the\nyears."
    } ]
  }, {
    "tStartMs": 609920,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So much of it I just have to, like,\nthrow out."
    } ]
  }, {
    "tStartMs": 611680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And this is just like part\nof what the job is now."
    } ]
  }, {
    "tStartMs": 613520,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "We're building on a new thing"
