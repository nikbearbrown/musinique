  "events": [ {
    "tStartMs": 400,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "When we first released Claude Code,"
    } ]
  }, {
    "tStartMs": 2160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "it was like a little video"
    } ]
  }, {
    "tStartMs": 3520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and I remember posting it to Slack,"
    } ]
  }, {
    "tStartMs": 4880,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and there was like two people\nthat gave like the reactions"
    } ]
  }, {
    "tStartMs": 7600,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and like people were like excited."
    } ]
  }, {
    "tStartMs": 9360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "I thought it was really cool,"
    } ]
  }, {
    "tStartMs": 10800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "especially for my very easy\nengineering tasks."
    } ]
  }, {
    "tStartMs": 13680,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "It was quite good at it."
    } ]
  }, {
    "tStartMs": 14640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That's like a really nice way\nto say that"
    } ]
  }, {
    "tStartMs": 16000,
    "dDurationMs": 13520,
    "segs": [ {
      "utf8": "it wasn't really good."
    } ]
  }, {
    "tStartMs": 31040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I can't believe\nit's only been a year"
    } ]
  }, {
    "tStartMs": 32720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "since we first launched\nClaude Code."
    } ]
  }, {
    "tStartMs": 34480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's hard to remember what\nwhat that was like."
    } ]
  }, {
    "tStartMs": 36960,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Like, it’s so different\nthan what we're doing today."
    } ]
  }, {
    "tStartMs": 40720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Like, now I just have, like,\narmies of agents"
    } ]
  }, {
    "tStartMs": 42800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "that are doing stuff like I'm"
    } ]
  }, {
    "tStartMs": 44560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "prompting one agent\nor I have like an agent"
    } ]
  }, {
    "tStartMs": 46560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that's like prompting agents,\nthat's prompting agents."
    } ]
  }, {
    "tStartMs": 48560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And it's like a tree\nof like thousands of agents."
    } ]
  }, {
    "tStartMs": 50880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But I think it's just like\nthe most important idea"
    } ]
  }, {
    "tStartMs": 53040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "when working on this stuff"
    } ]
  }, {
    "tStartMs": 54000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "is like, every single time\nClaude makes a mistake."
    } ]
  }, {
    "tStartMs": 57200,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I don't tell Claude\nto do it differently,"
    } ]
  }, {
    "tStartMs": 58960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I tell it to write it\nto the CLAUDE.md,"
    } ]
  }, {
    "tStartMs": 60880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "or to like make a skill or"
    } ]
  }, {
    "tStartMs": 62480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "or something\nto do it differently."
    } ]
  }, {
    "tStartMs": 64480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And if you can do this,\nthen Claude"
    } ]
  }, {
    "tStartMs": 66000,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "can just like run forever."
    } ]
  }, {
    "tStartMs": 67600,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And I think the other thing\nthat we kind of realize is"
    } ]
  }, {
    "tStartMs": 69680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "the verification\nis really important."
    } ]
  }, {
    "tStartMs": 71600,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Like we didn't realize that."
    } ]
  }, {
    "tStartMs": 72640,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I hear this come up\na lot with developers"
    } ]
  }, {
    "tStartMs": 75200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and enterprises\nthat we meet with."
    } ]
  }, {
    "tStartMs": 77520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "What are your tips for making\na really good"
    } ]
  }, {
    "tStartMs": 79680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "making Claude Code really good\nat verification?"
    } ]
  }, {
    "tStartMs": 81760,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I sort of feel like this"
    } ]
  }, {
    "tStartMs": 82720,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "is this thing that"
    } ]
  }, {
    "tStartMs": 83840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "just like everyone misunderstands"
    } ]
  }, {
    "tStartMs": 85280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "because whenever we talk about\nverification,"
    } ]
  }, {
    "tStartMs": 87360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "people are thinking like unit tests"
    } ]
  }, {
    "tStartMs": 88720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "or they're thinking like lint\nor like type check."
    } ]
  }, {
    "tStartMs": 91280,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "These are the things that are"
    } ]
  }, {
    "tStartMs": 92400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "obviously really easy to automate."
    } ]
  }, {
    "tStartMs": 93920,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And these are the things\nthat were already automated."
    } ]
  }, {
    "tStartMs": 96480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "But actually when we talk\nabout verification"
    } ]
  }, {
    "tStartMs": 98000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for agents, it's\nsomething slightly different."
    } ]
  }, {
    "tStartMs": 100160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It's like can the agent run\nthe thing?"
    } ]
  }, {
    "tStartMs": 102240,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It takes a little bit of\nmental work"
    } ]
  }, {
    "tStartMs": 104080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to figure out\nhow exactly do you do this,"
    } ]
  }, {
    "tStartMs": 105920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "because it's often\nnot straightforward."
    } ]
  }, {
    "tStartMs": 107600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And I think that's like,"
    } ]
  }, {
    "tStartMs": 108560,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "that’s one of the challenges.\nI remember"
    } ]
  }, {
    "tStartMs": 110400,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I remember with Opus 4"
    } ]
  }, {
    "tStartMs": 112720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Claude tested itself."
    } ]
  }, {
    "tStartMs": 114720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "And we just like\nhooked it up to Opus 4"
    } ]
  }, {
    "tStartMs": 118000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And I was like, Claude\nbuild the feature"
    } ]
  }, {
    "tStartMs": 119840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and then test yourself\nin like bash."
    } ]
  }, {
    "tStartMs": 122560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And it opened a little Claude\nCLI and tested"
    } ]
  }, {
    "tStartMs": 125920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "its own feature."
    } ]
  }, {
    "tStartMs": 127520,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And I was just like, whoa."
    } ]
  }, {
    "tStartMs": 130000,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "It's crazy!"
    } ]
  }, {
    "tStartMs": 130720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Like now,\nnow we're so used to it."
    } ]
  }, {
    "tStartMs": 132160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Like now, you know, now\nwe have these loops going for,"
    } ]
  }, {
    "tStartMs": 134640,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "you know,\nlike the iOS simulator"
    } ]
  }, {
    "tStartMs": 135760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and the Android simulator\nand like computers"
    } ]
  }, {
    "tStartMs": 138160,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "for desktop,\nlike it's not surprising."
    } ]
  }, {
    "tStartMs": 140480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "But back then that was crazy."
    } ]
  }, {
    "tStartMs": 142080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "How are, like,\nhow are you doing it?"
    } ]
  }, {
    "tStartMs": 144480,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So I've been mainly"
    } ]
  }, {
    "tStartMs": 145920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hacking on the desktop app\nthese days."
    } ]
  }, {
    "tStartMs": 147920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And one of the engineers\non the team"
    } ]
  }, {
    "tStartMs": 149760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "actually added this desktop"
    } ]
  }, {
    "tStartMs": 151040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "development skill"
    } ]
  }, {
    "tStartMs": 152000,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that teaches Claude how\nto run the local desktop app."
    } ]
  }, {
    "tStartMs": 155040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And I've been having it\nuse it,"
    } ]
  }, {
    "tStartMs": 156480,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and it still runs into issues\nor like bugs"
    } ]
  }, {
    "tStartMs": 160160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "with the staging environment\nsometimes."
    } ]
  }, {
    "tStartMs": 162320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And so what I have it do\nis in those cases,"
    } ]
  }, {
    "tStartMs": 164400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I have it read\nSlack and understand, hey,"
    } ]
  }, {
    "tStartMs": 166640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "is staging down right now?"
    } ]
  }, {
    "tStartMs": 168320,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Or has someone\nelse already hit this?"
    } ]
  }, {
    "tStartMs": 171680,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And then when it"
    } ]
  }, {
    "tStartMs": 172800,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "debugs the whole issue,"
    } ]
  }, {
    "tStartMs": 174160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "I tell it to update\nthe desktop development skill."
    } ]
  }, {
    "tStartMs": 176320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "What the skill does is"
    } ]
  }, {
    "tStartMs": 177840,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Claude actually spins up\na local desktop app,"
    } ]
  }, {
    "tStartMs": 180160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and it uses computer\nuse to click around on it."
    } ]
  }, {
    "tStartMs": 183120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And so when I add a new UX,"
    } ]
  }, {
    "tStartMs": 185200,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "it clicks around\nto invoke the new UX."
    } ]
  }, {
    "tStartMs": 187920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It also tests edge cases,"
    } ]
  }, {
    "tStartMs": 189840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and when there's an issue\nit fixes it and re-checks."
    } ]
  }, {
    "tStartMs": 193040,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "This is like honestly,\none of my favorite things"
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "about this team\nis everyone codes."
    } ]
  }, {
    "tStartMs": 197920,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I've never been on a\nteam where, like,"
    } ]
  }, {
    "tStartMs": 202080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "my PM would code"
    } ]
  }, {
    "tStartMs": 203360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and it's like crazy and like\nyour code is like really good."
    } ]
  }, {
    "tStartMs": 206720,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You’re too nice."
    } ]
  }, {
    "tStartMs": 208720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "But I also just feel like it's"
    } ]
  }, {
    "tStartMs": 210480,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "it's also just becoming easier"
    } ]
  }, {
    "tStartMs": 211840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "because it's like essentially\nClaude writes the code."
    } ]
  }, {
    "tStartMs": 214720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And so what matters\na little more is like,"
    } ]
  }, {
    "tStartMs": 216720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "what's the idea that you have?"
    } ]
  }, {
    "tStartMs": 218480,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "And I feel like"
    } ]
  }, {
    "tStartMs": 219520,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "if you're a person"
    } ]
  }, {
    "tStartMs": 220080,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "that has like\nthe product context"
    } ]
  }, {
    "tStartMs": 221120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and the business context\nand you're thinking"
    } ]
  }, {
    "tStartMs": 222480,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "about the design and the user,"
    } ]
  }, {
    "tStartMs": 224160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "you're just going to come up\nwith better ideas."
    } ]
  }, {
    "tStartMs": 226160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It's kind of like\nall the roles are merging."
    } ]
  }, {
    "tStartMs": 228160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I remember seeing Megan\nour designer’s PRs"
    } ]
  }, {
    "tStartMs": 230800,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and I was just horrified\nat the beginning"
    } ]
  }, {
    "tStartMs": 232400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I was like, oh my God, why is\nMegan putting up PRs?"
    } ]
  }, {
    "tStartMs": 234800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And then she was like,\nyeah, yeah."
    } ]
  }, {
    "tStartMs": 236000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "I'm just like,\nI'm fixing the button."
    } ]
  }, {
    "tStartMs": 237760,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "And I was like,"
    } ]
  }, {
    "tStartMs": 238480,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "okay, all right, well,\nthe code looks good,"
    } ]
  }, {
    "tStartMs": 240240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "so maybe it's maybe it's fine."
    } ]
  }, {
    "tStartMs": 242160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And I feel like now it's\njust like it's totally normal."
    } ]
  }, {
    "tStartMs": 244560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yeah, and we see this across"
