  }, {
    "tStartMs": 245760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "all the enterprises we talk with."
    } ]
  }, {
    "tStartMs": 247680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Like, it's the engineers adopt\nClaude Code first"
