  }, {
    "tStartMs": 250880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and then the, the eng adjecent\nroles look over their shoulder"
    } ]
  }, {
    "tStartMs": 254720,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and they're like, whoa,\nthis thing is very powerful."
    } ]
  }, {
    "tStartMs": 256800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Let me try it out.\nAnd we found it's crazy."
    } ]
  }, {
    "tStartMs": 259680,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "We found that, like,"
    } ]
  }, {
    "tStartMs": 260560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "our designers are more\nproductive making prototypes"
