  }, {
    "tStartMs": 585840,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "the most intelligent attacks\nthat we can construct."
    } ]
  }, {
    "tStartMs": 590240,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Yeah. I mean, it's like,"
    } ]
  }, {
    "tStartMs": 591040,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it’s honestly\nlike a weird approach."
    } ]
  }, {
    "tStartMs": 592720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I feel like there's, like,\nall these features"
