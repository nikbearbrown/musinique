  }, {
    "tStartMs": 669680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "seeing entire engineering\norgs change?"
    } ]
  }, {
    "tStartMs": 672400,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I'm going to put on my\nbusiness cat hat."
