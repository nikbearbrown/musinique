  }, {
    "tStartMs": 276240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Like if you talk with our\ndata scientists, it's so cool."
    } ]
  }, {
    "tStartMs": 278800,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's just like everyone just has"
