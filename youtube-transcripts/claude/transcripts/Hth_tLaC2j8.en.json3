  }, {
    "tStartMs": 600720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "like I'm actually wrong,\nlike so often now."
    } ]
  }, {
    "tStartMs": 603440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Because, like, building on\nthe model is so weird."
