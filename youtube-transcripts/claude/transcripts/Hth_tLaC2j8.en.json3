  }, {
    "tStartMs": 594720,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "the last year"
    } ]
  }, {
    "tStartMs": 595440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "where the first time\nsomeone pitched it,"
