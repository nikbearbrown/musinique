  }, {
    "tStartMs": 266800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "PMs are making changes in the app."
    } ]
  }, {
    "tStartMs": 269680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Our finance team runs\nand in Claude Code,"
